*{box-sizing:border-box}
:root{font-family:Arial,Helvetica,sans-serif;color:#172033;background:#f3f6fb}
body{margin:0;min-height:100vh;background:radial-gradient(circle at top left,#dcecff 0,transparent 35%),#f3f6fb}
.container{width:min(760px,calc(100% - 28px));margin:40px auto}
.card{background:#fff;border-radius:22px;padding:30px;box-shadow:0 16px 45px rgba(27,47,83,.12)}
.brand{font-size:13px;font-weight:800;letter-spacing:1.4px;color:#356ae6;margin-bottom:8px}
h1{margin:0;font-size:32px}.subtitle{color:#687386;margin-top:8px}
label,.label{display:block;font-size:13px;color:#687386;margin-bottom:7px}
.search-row{display:flex;gap:10px}
input{flex:1;min-width:0;height:50px;padding:0 15px;border:1px solid #ccd4e0;border-radius:12px;font-size:16px;outline:none}
input:focus{border-color:#356ae6;box-shadow:0 0 0 3px rgba(53,106,230,.12)}
button{height:50px;border:0;border-radius:12px;padding:0 22px;background:#356ae6;color:white;font-size:15px;font-weight:700;cursor:pointer}
button:hover{opacity:.92}.message{min-height:24px;margin-top:14px;color:#b42318;font-size:14px}
.hidden{display:none}.result{margin-top:8px;border-top:1px solid #e8edf4;padding-top:22px}
.result-head{display:grid;grid-template-columns:1fr 2fr;gap:16px;margin-bottom:18px}
.result-head strong{display:block;font-size:18px}
.info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.info-box{padding:16px;border:1px solid #e7ebf2;border-radius:14px;background:#fafbfd}
.info-box span{display:block;color:#687386;font-size:13px;margin-bottom:6px}
.info-box strong{font-size:17px}.total-box{margin-top:14px;padding:18px;border-radius:14px;background:#eef4ff;display:flex;justify-content:space-between;align-items:center}
.total-box span{font-weight:700}.total-box strong{font-size:24px}
.secondary{width:100%;margin-top:14px;background:#eef1f6;color:#25324a}
footer{margin-top:24px;text-align:center;color:#8993a4;font-size:12px}
@media(max-width:560px){.container{margin:15px auto}.card{padding:22px;border-radius:18px}h1{font-size:27px}.search-row{flex-direction:column}button{width:100%}.result-head,.info-grid{grid-template-columns:1fr}}
